<Project Sdk="Microsoft.NET.Sdk.Worker">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <DefaultItemExcludes>$(DefaultItemExcludes);KaedeHikarinApiPhiRecorderWorkerLib\**</DefaultItemExcludes>
        <UserSecretsId>dotnet-KaedeHikarinCialloTeam.PhiRecorder.Worker-338702c7-889f-4e56-972c-081401ff4b2e</UserSecretsId>
        <NativeLibSource>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\KaedeHikarinApiPhiRecorderWorkerLib'))</NativeLibSource>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11"/>
    </ItemGroup>

    <Target Name="CopyPhiNativeRuntime" AfterTargets="Build">
        <PropertyGroup>
            <NativeBinDir>$(NativeLibSource)\target\$(Configuration)</NativeBinDir>
        </PropertyGroup>
        <ItemGroup>
            <_PhiNativeDll Include="$(NativeBinDir)\phi_recorder.dll"/>
            <_PhiNativeHost Include="$(NativeBinDir)\phi-renderer-host.exe"/>
            <_PhiNativeAssets Include="$(NativeLibSource)\assets\**\*"/>
        </ItemGroup>
        <MakeDir Directories="$(OutDir)native"/>
        <Copy SourceFiles="@(_PhiNativeDll);@(_PhiNativeHost)"
              DestinationFolder="$(OutDir)native"
              SkipUnchangedFiles="true"
              Condition="Exists('%(FullPath)')"/>
        <Copy SourceFiles="@(_PhiNativeAssets)"
              DestinationFiles="$(OutDir)native\assets\%(RecursiveDir)%(Filename)%(Extension)"
              SkipUnchangedFiles="true"/>
        <Warning Text="phi_recorder native runtime not found at $(NativeBinDir); build KaedeHikarinApiPhiRecorderWorkerLib first"
                 Condition="!Exists('$(NativeBinDir)\phi_recorder.dll')"/>
    </Target>
</Project>
