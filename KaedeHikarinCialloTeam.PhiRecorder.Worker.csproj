<Project Sdk="Microsoft.NET.Sdk.Worker">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <DefaultItemExcludes>$(DefaultItemExcludes);KaedeHikarinApiPhiRecorderWorkerLib\**</DefaultItemExcludes>
        <UserSecretsId>dotnet-KaedeHikarinCialloTeam.PhiRecorder.Worker-338702c7-889f-4e56-972c-081401ff4b2e</UserSecretsId>
        <NativeLibSource>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\KaedeHikarinApiPhiRecorderWorkerLib'))</NativeLibSource>
        <PhiNativeProfile Condition="'$(Configuration)' == 'Release'">release</PhiNativeProfile>
        <PhiNativeProfile Condition="'$(PhiNativeProfile)' == ''">debug</PhiNativeProfile>
        <PhiNativeBinDir>$(NativeLibSource)\target\$(PhiNativeProfile)</PhiNativeBinDir>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="AWSSDK.S3" Version="4.0.102.5" />
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
        <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.11" />
        <PackageReference Include="RabbitMQ.Client" Version="7.2.2" />
    </ItemGroup>

    <Target Name="BuildPhiNative" BeforeTargets="CopyPhiNativeRuntime" Condition="'$(SkipPhiNativeBuild)' != 'true'">
        <PropertyGroup>
            <PhiNativeCargoArgs Condition="'$(PhiNativeProfile)' == 'release'">--release</PhiNativeCargoArgs>
        </PropertyGroup>
        <Exec Command="cargo --version" IgnoreExitCode="true" StandardErrorImportance="High">
            <Output TaskParameter="ExitCode" PropertyName="_PhiCargoMissing" />
        </Exec>
        <Error Condition="'$(_PhiCargoMissing)' != '0'" Text="cargo was not found on PATH. Install the Rust toolchain (rust-version 1.77.2+, see KaedeHikarinApiPhiRecorderWorkerLib/AGENTS.md) or set SkipPhiNativeBuild=true to copy prebuilt native artifacts." />
        <Exec Command="cargo build --locked $(PhiNativeCargoArgs)" WorkingDirectory="$(NativeLibSource)" ConsoleToMSBuild="true" />
    </Target>

    <Target Name="CopyPhiNativeRuntime" AfterTargets="Build">
        <ItemGroup>
            <_PhiNativeDll Include="$(PhiNativeBinDir)\phi_recorder.dll" />
            <_PhiNativeHost Include="$(PhiNativeBinDir)\phi-renderer-host.exe" />
            <_PhiNativeAssets Include="$(NativeLibSource)\assets\**\*" />
        </ItemGroup>
        <MakeDir Directories="$(OutDir)native" />
        <Copy SourceFiles="@(_PhiNativeDll);@(_PhiNativeHost)" DestinationFolder="$(OutDir)native" SkipUnchangedFiles="true" Condition="Exists('%(FullPath)')" />
        <Copy SourceFiles="@(_PhiNativeAssets)" DestinationFiles="$(OutDir)native\assets\%(RecursiveDir)%(Filename)%(Extension)" SkipUnchangedFiles="true" />
        <Error Text="phi_recorder.dll not found at $(PhiNativeBinDir) after the native build. Check the cargo build output above, or set SkipPhiNativeBuild=true to use prebuilt native artifacts." Condition="!Exists('$(PhiNativeBinDir)\phi_recorder.dll')" />
    </Target>

    <Target Name="CopyPhiNativeRuntimeToPublish" AfterTargets="Publish">
        <ItemGroup>
            <_PhiNativeOut Include="$(OutDir)native\**\*" />
        </ItemGroup>
        <Copy SourceFiles="@(_PhiNativeOut)" DestinationFiles="$(PublishDir)native\%(RecursiveDir)%(Filename)%(Extension)" SkipUnchangedFiles="true" />
    </Target>
</Project>
